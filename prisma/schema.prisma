generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ВАШИ СУЩЕСТВУЮЩИЕ МОДЕЛИ (БЕЗ ИЗМЕНЕНИЙ) ---

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  password   String
  name       String?
  categories Category[]
  templates  Template[]
  pcaDrugs   PcaDrug[]
  history    AIHistory[]
  createdAt  DateTime    @default(now())
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id])
  templates Template[]
}

model Template {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  author     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model PcaDrug {
  id        Int      @id @default(autoincrement())
  name      String
  strength  Float    // mg/ml
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

model AIHistory {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  mode         String   // fix, translate, summarize, malli
  originalText String   @db.Text
  resultText   String   @db.Text

  @@index([userId])
}

// --- ОБНОВЛЕННЫЙ МОДУЛЬ: СПРАВОЧНИК ЛЕКАРСТВ (FIMEA) ---
// Мы заменяем старую плоскую модель Medicine на трехуровневую систему

model Substance {
  id              String     @id // Название вещества (напр. "takrolimuusi")
  laake75Class    String?    // Категория безопасности (A, B, C, D)
  laake75Comment  String?    @db.Text // Комментарий Lääke75+
  gfrGuidelines   String?    @db.Text // Ваши клинические заметки по GFR
  isBiological    Boolean    @default(false)
  medicines       Medicine[]
}

model Medicine {
  id               String      @id // XML ID (напр. "REL53213")
  name             String      // Kauppanimi (напр. "Advagraf")
  atcCode          String?
  prescriptionTerm String?     @db.Text // Maaraamisehto (Условия выписки)
  isPediatric      Boolean     @default(false) // Lastenlaake
  isBiosimilar     Boolean     @default(false) // Biosimilaari
  status           String?     // Статус лицензии
  substance        Substance?  @relation(fields: [substanceId], references: [id])
  substanceId      String?
  packages         Package[]

  @@index([name])
}

model Package {
  vnr             String    @id // VNR-номер (020566)
  medicineId      String
  medicine        Medicine  @relation(fields: [medicineId], references: [id])
  sizeText        String?   // Текст упаковки (напр. "10 x 20 ml")
  strength        String?   // Дозировка (1 mg)
  form            String?   // Форма (depotkapseli)
  container       String?   // Тара (Injektiopullo)
  isAvailable     Boolean   @default(true) // Kaupan: 1/0
  dddValue        Float?    // DDD (5.0)
  dddUnit         String?   // DDD yksikkö (mg)
  updatedAt       DateTime  @updatedAt

  @@index([medicineId])
}
