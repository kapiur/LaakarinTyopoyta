datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  templates Template[]
}

model Template {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  author     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}
