generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ПОЛЬЗОВАТЕЛИ И АУТЕНТИФИКАЦИЯ
// ==========================================

enum UserRole {
  ADMIN
  USER
}

model User {
  id                 Int              @id @default(autoincrement())
  // Core first-party account identity. These values are not patient-text anonymization targets.
  email              String           @unique
  password           String
  name               String?
  role               UserRole         @default(USER)
  isActive           Boolean          @default(true)
  mustChangePassword Boolean          @default(false)
  uiLanguage         String           @default("fi")
  lastLoginAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Обратные связи
  categories      Category[]
  templates       Template[]
  pcaDrugs        PcaDrug[]
  pedsDrugs       PedsDrug[]
  pedsIndications PedsIndication[]
  calculatorPreferences UserCalculatorPreference[]
  history         AIHistory[]
  aiRunAuditLogs  AiRunAuditLog[]
  aiTools         AiTool[]
  aiProfile       UserAiProfile?
  clinicalSettings UserClinicalSettings?
  clinicalSourcePreferences UserClinicalSourcePreference[]
  substanceNotes  Substance[]      // Связь для Wiki-заметок
  
  // Новые связи для каталога ссылок
  linkCategories  LinkCategory[]
  quickLinks      QuickLink[]
}

// ==========================================
// 2. ШАБЛОНЫ ТЕКСТОВ (MALLIT)
// ==========================================

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  userId    Int?       // null для общих категорий
  user      User?      @relation(fields: [userId], references: [id])
  templates Template[]
}

model Template {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  author     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

// ==========================================
// 3. КАЛЬКУЛЯТОРЫ И ИИ
// ==========================================

model PcaDrug {
  id        Int      @id @default(autoincrement())
  name      String
  strength  Float    // mg/ml
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

enum PedsDrugForm {
  LIQUID
  TABLET
}

enum PedsDoseUnit {
  MG
  IU
}

model PedsIndication {
  id        Int                  @id @default(autoincrement())
  name      String
  userId    Int
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  drugs     PedsDrugIndication[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model PedsDrug {
  id           Int                  @id @default(autoincrement())
  name         String
  form         PedsDrugForm
  unit         PedsDoseUnit
  strength     Float                // mg/ml, IU/ml, mg/tabletti tai IU/tabletti
  dosePerKgDay Float                // mg/kg/vrk tai IU/kg/vrk
  timesPerDay  Int
  defaultDays  Int?
  packageSize  Float?               // ml tai kpl
  note         String?              @db.Text
  userId       Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  indications  PedsDrugIndication[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, name, form, strength])
  @@index([userId])
}

model PedsDrugIndication {
  drugId       Int
  indicationId Int
  drug         PedsDrug       @relation(fields: [drugId], references: [id], onDelete: Cascade)
  indication   PedsIndication @relation(fields: [indicationId], references: [id], onDelete: Cascade)

  @@id([drugId, indicationId])
  @@index([indicationId])
}

model UserCalculatorPreference {
  id            String   @id @default(cuid())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calculatorKey String
  isVisible     Boolean  @default(true)
  customOrder   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, calculatorKey])
  @@index([userId])
}

model AIHistory {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  mode         String   // fix, translate, summarize, malli
  originalText String   @db.Text
  resultText   String   @db.Text

  @@index([userId])
}

model AiRunAuditLog {
  id                   String   @id @default(cuid())
  createdAt            DateTime @default(now())
  userId               Int
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface              String
  taskType             String?
  contextType          String?
  provider             String?
  model                String?
  clinicalCountry      String?
  evidenceStatus       String?
  privacyFindingTypes  String   @default("[]") @db.Text
  blockedByEvidenceGate Boolean @default(false)
  latencyMs            Int?
  success              Boolean  @default(true)
  errorCode            String?  @db.Text

  @@index([userId, createdAt])
  @@index([surface, createdAt])
  @@index([taskType])
  @@index([clinicalCountry])
}

enum AiToolScope {
  SYSTEM
  USER
}

model AiTool {
  id               String      @id @default(cuid())
  key              String
  label            String
  description      String?
  icon             String?
  prompt           String      @db.Text
  scope            AiToolScope
  userId           Int?
  user             User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive         Boolean     @default(true)
  order            Int         @default(100)
  useUserAiProfile Boolean     @default(true)
  profileMode      String      @default("full")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([key])
  @@index([userId])
  @@index([scope, isActive, order])
  @@index([profileMode])
}

model UserAiProfile {
  id                     String                @id @default(cuid())
  userId                 Int                   @unique
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // AI-facing free-text profile fields may require privacy sanitization before persistence.
  role                   String?
  specialty              String?
  workplace              String?
  experienceLevel        String?
  defaultClinicalContext String?
  preferredStructure     String?
  detailLevel            String?
  writingStyle           String?
  permanentInstructions  String?               @db.Text
  avoidInstructions      String?               @db.Text
  styleSummary           String?               @db.Text
  useProfileByDefault    Boolean               @default(true)
  samples                UserAiProfileSample[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([userId])
}

model UserAiProfileSample {
  id             String        @id @default(cuid())
  profileId      String
  profile        UserAiProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  anonymizedText String?       @db.Text
  sourceLabel    String?
  styleNotes     String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([profileId])
}

model AiProviderCredential {
  id              String   @id @default(cuid())
  provider        String   @unique
  label           String?
  encryptedSecret String   @db.Text
  keyPreview      String?
  baseUrl         String?
  isEnabled       Boolean  @default(true)
  isDefault       Boolean  @default(false)
  defaultModel    String?
  allowedModels   String?  @db.Text
  lastTestedAt    DateTime?
  lastTestOk      Boolean?
  lastTestError   String?  @db.Text
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isEnabled])
}

model UserClinicalSettings {
  id                       String   @id @default(cuid())
  userId                   Int      @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceCountry          String   @default("FI")
  usePracticeCountryDefaults Boolean @default(true)
  clinicalCountry           String   @default("FI")
  clinicalOutputLanguage    String   @default("fi")
  evidenceStrictness        String   @default("strict")
  allowLocalSources         Boolean  @default(true)
  allowSupplementarySources Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([clinicalCountry])
  @@index([practiceCountry])
}

model ClinicalSource {
  id             String   @id
  country        String
  name           String
  description    String?  @db.Text
  sourceType     String
  trustLevel     String
  priority       Int      @default(100)
  baseUrl        String?
  allowedDomains Json?
  language       Json?
  isEnabled      Boolean  @default(true)
  isOfficial     Boolean  @default(false)
  specialty      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preferences    UserClinicalSourcePreference[]

  @@index([country])
  @@index([sourceType])
  @@index([trustLevel])
  @@index([isEnabled])
}

model UserClinicalSourcePreference {
  id                         String         @id @default(cuid())
  userId                     Int
  user                       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId                   String
  source                     ClinicalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  country                    String
  isEnabled                  Boolean        @default(true)
  priorityOverride           Int?
  useForAgent                Boolean        @default(true)
  useForPikaohjeet           Boolean        @default(true)
  useForPatientInstructions  Boolean        @default(true)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@unique([userId, sourceId])
  @@index([userId, country])
  @@index([sourceId])
}

// ==========================================
// 4. СПРАВОЧНИК ЛЕКАРСТВ (FIMEA + WIKI)
// ==========================================

model Substance {
  id              String     @id // Название вещества (напр. "takrolimuusi")
  communityNotes  String?    @db.Text
  lastUpdatedById Int?
  lastUpdatedBy   User?      @relation(fields: [lastUpdatedById], references: [id]) 
  
  laake75Class    String?    
  laake75Comment  String?    @db.Text
  gfrGuidelines   String?    @db.Text
  isBiological    Boolean    @default(false)
  medicines       Medicine[]
}

model Medicine {
  id               String     @id 
  name             String     
  atcCode          String?
  prescriptionTerm String?    @db.Text 
  isPediatric      Boolean    @default(false)
  isBiosimilar     Boolean    @default(false)
  status           String?    
  substance        Substance? @relation(fields: [substanceId], references: [id])
  substanceId      String?
  packages         Package[]

  @@index([name])
}

model Package {
  vnr         String   @id
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id])
  sizeText    String?
  strength    String?
  form        String?
  container   String?
  isAvailable Boolean  @default(true)
  dddValue    Float?
  dddUnit     String?
  updatedAt   DateTime @updatedAt

  @@index([medicineId])
}

// ==========================================
// 5. КЛИНИЧЕСКИЕ КАРТОЧКИ (PIKAOHJEET)
// ==========================================

model ClinicalCard {
  id              Int                @id @default(autoincrement())
  slug            String             @unique
  title           String
  subtitle        String?
  environment     String             @default("terveysasema")
  audience        String             @default("aikuinen")
  tags            String[]           @default([])
  isPublished     Boolean            @default(true)
  updatedAt       DateTime           @updatedAt
  createdAt       DateTime           @default(now())
  updatedByUserId String?
  updatedByEmail  String?
  updatedByName   String?

  sections        ClinicalSection[]
  fields          ClinicalField[]
  rules           ClinicalRule[]
  revisions       ClinicalRevision[]
}

model ClinicalSection {
  id               Int            @id @default(autoincrement())
  cardId           Int
  card             ClinicalCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  key              String
  title            String
  order            Int            @default(0)
  content          String         @db.Text
  highlightCallout String?
  
  rules            ClinicalRule[]

  @@unique([cardId, key])
  @@index([cardId, order])
}

model ClinicalField {
  id          Int            @id @default(autoincrement())
  cardId      Int
  card        ClinicalCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        String
  unit        String?
  placeholder String?
  options     String[]       @default([])
  order       Int            @default(0)
  isUniversal Boolean        @default(false)
  
  rules       ClinicalRule[]

  @@unique([cardId, key])
  @@index([cardId, order])
}

model ClinicalRule {
  id                  Int              @id @default(autoincrement())
  cardId              Int
  card                ClinicalCard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  groupId             String?
  fieldKey            String
  field               ClinicalField    @relation(fields: [cardId, fieldKey], references: [cardId, key], onDelete: Cascade)
  operator            String
  value               String
  highlightSectionKey String?
  section             ClinicalSection? @relation(fields: [cardId, highlightSectionKey], references: [cardId, key], onDelete: Cascade)
  addHint             String?
  priority            Int              @default(50)

  @@index([cardId, priority])
}

model ClinicalRevision {
  id           Int          @id @default(autoincrement())
  cardId       Int
  card         ClinicalCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  editorUserId String?
  editorEmail  String?
  editorName   String?
  action       String
  summary      String?
  payload      Json?

  @@index([cardId, createdAt])
}

// ==========================================
// 6. КАТАЛОГ ССЫЛОК (LINKIT JA OHJEET)
// ==========================================

model LinkCategory {
  id        Int         @id @default(autoincrement())
  name      String
  userId    Int?        // null = общая категория для всех
  user      User?       @relation(fields: [userId], references: [id])
  links     QuickLink[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model QuickLink {
  id          Int          @id @default(autoincrement())
  title       String       // Описание
  url         String       // Ссылка
  categoryId  Int
  category    LinkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId      Int?         // null = общая ссылка для всех
  user        User?        @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
  @@index([userId])
}

// ==========================================
// 7. СИСТЕМНОЕ
// ==========================================

model AdminPrompt {
  id        String   @id @default(cuid())
  label     String
  content   String   @db.Text
  createdAt DateTime @default(now())
}
