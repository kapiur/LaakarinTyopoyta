generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  name       String?
  categories Category[]
  templates  Template[]
  pcaDrugs   PcaDrug[]
  history    AIHistory[] // Связь с историей запросов
  createdAt  DateTime   @default(now())
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id])
  templates Template[]
}

model Template {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text // Используем Text для длинных шаблонов
  author     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model PcaDrug {
  id        Int      @id @default(autoincrement())
  name      String
  strength  Float    // mg/ml
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

// --- НОВЫЙ МОДУЛЬ: СПРАВОЧНИК ЛЕКАРСТВ (FIMEA) ---
model Medicine {
  id                String   @id @default(cuid())
  vnr               String   @unique // VNR-koodi
  name              String   // Kauppanimi
  substance         String   // Vaikuttava aine
  strength          String   // Vahvuus
  form              String   // Muoto
  atcCode           String?  // ATC-koodi
  
  indications       String?  @db.Text // Käyttötarkoitus
  gfrInstructions   String?  @db.Text // Munuaisten vajaatoiminta -ohje
  standardDosage    String?  @db.Text // Annostusohje
  
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([substance])
}

// --- НОВЫЙ МОДУЛЬ: ИСТОРИЯ ОБРАБОТКИ ТЕКСТА ---
model AIHistory {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  mode         String   // fix, translate, summarize, malli
  originalText String   @db.Text
  resultText   String   @db.Text

  @@index([userId])
}
