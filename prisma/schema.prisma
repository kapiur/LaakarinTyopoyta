generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ВАШИ СУЩЕСТВУЮЩИЕ МОДЕЛИ (БЕЗ ИЗМЕНЕНИЙ) ---

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  password        String
  name            String?
  categories      Category[]
  templates       Template[]
  pcaDrugs        PcaDrug[]
  history         AIHistory[]
  substanceNotes  Substance[]      // Связь для отслеживания авторства Wiki-заметок
  createdAt       DateTime         @default(now())
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id])
  templates Template[]
}

model Template {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  author     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model PcaDrug {
  id        Int      @id @default(autoincrement())
  name      String
  strength  Float    // mg/ml
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

model AIHistory {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  mode         String   // fix, translate, summarize, malli
  originalText String   @db.Text
  resultText   String   @db.Text

  @@index([userId])
}

// --- ОБНОВЛЕННЫЙ МОДУЛЬ: СПРАВОЧНИК ЛЕКАРСТВ (FIMEA + Wiki-заметки) ---

// 1. Уровень Вещества: «Клинический мозг» и Wiki-сообщество
model Substance {
  id              String     @id // Название вещества (напр. "takrolimuusi")
  communityNotes  String?    @db.Text // Общие Wiki-заметки для всех врачей
  lastUpdatedById Int?       // ID врача, внесшего последнюю правку
  lastUpdatedBy   User?      @relation(fields: [lastUpdatedById], references: [id]) 
  
  laake75Class    String?    // Категория безопасности (A, B, C, D)
  laake75Comment  String?    @db.Text // Официальный комментарий Lääke75+
  gfrGuidelines   String?    @db.Text // Специфические заметки по GFR
  isBiological    Boolean    @default(false)
  medicines       Medicine[]
}

// 2. Уровень Препарата: «Рецептурный справочник»
model Medicine {
  id               String      @id // XML ID (напр. "REL53213")
  name             String      // Kauppanimi (напр. "Advagraf")
  atcCode          String?
  prescriptionTerm String?     @db.Text // Maaraamisehto (Условия выписки)
  isPediatric      Boolean     @default(false) // Флаг детского препарата
  isBiosimilar     Boolean     @default(false) // Статус биосимиляра
  status           String?     // Статус лицензии (напр. "Myyntilupa myönnetty")
  substance        Substance?  @relation(fields: [substanceId], references: [id])
  substanceId      String?
  packages         Package[]

  @@index([name])
}

// 3. Уровень Упаковки: «Физические данные для рецепта и калькулятора»
model Package {
  vnr             String    @id // VNR-номер (020566)
  medicineId      String
  medicine        Medicine  @relation(fields: [medicineId], references: [id])
  sizeText        String?   // Текст упаковки (напр. "10 x 20 ml")
  strength        String?   // Дозировка (1 mg)
  form            String?   // Форма (depotkapseli)
  container       String?   // Тара (Injektiopullo)
  isAvailable     Boolean   @default(true) // В продаже ли сейчас
  dddValue        Float?    // Среднесуточная доза (5.0)
  dddUnit         String?   // Единица DDD (mg)
  updatedAt       DateTime  @updatedAt

  @@index([medicineId])
}
// --- НОВЫЙ МОДУЛЬ: KLIINISET PIKAOHJEET ---

model ClinicalCard {
  id              Int                @id @default(autoincrement())
  slug            String             @unique
  title           String
  subtitle        String?
  environment     String             @default("terveysasema")
  audience        String             @default("aikuinen")
  tags            String[]           @default([])
  isPublished     Boolean            @default(true)
  updatedAt       DateTime           @updatedAt
  createdAt       DateTime           @default(now())
  updatedByUserId String?
  updatedByEmail  String?
  updatedByName   String?

  sections        ClinicalSection[]
  fields          ClinicalField[]
  rules           ClinicalRule[]
  revisions       ClinicalRevision[]
}

model ClinicalSection {
  id               Int            @id @default(autoincrement())
  cardId           Int
  card             ClinicalCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  key              String
  title            String
  order            Int            @default(0)
  content          String         @db.Text
  highlightCallout String?
  
  // Обратная связь для правил
  rules            ClinicalRule[]

  @@unique([cardId, key]) // Обязательно для связи в ClinicalRule
  @@index([cardId, order])
}

model ClinicalField {
  id          Int            @id @default(autoincrement())
  cardId      Int
  card        ClinicalCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        String
  unit        String?
  placeholder String?
  options     String[]       @default([])
  order       Int            @default(0)
  isUniversal Boolean        @default(false)
  
  // Обратная связь для правил
  rules       ClinicalRule[]

  @@unique([cardId, key]) // Обязательно для связи в ClinicalRule
  @@index([cardId, order])
}

model ClinicalRule {
  id                  Int              @id @default(autoincrement())
  cardId              Int
  card                ClinicalCard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  // Связь с полем
  fieldKey            String
  field               ClinicalField    @relation(fields: [cardId, fieldKey], references: [cardId, key], onDelete: Cascade)
  
  operator            String
  value               String
  
  // Связь с секцией
  highlightSectionKey String?
  section             ClinicalSection? @relation(fields: [cardId, highlightSectionKey], references: [cardId, key], onDelete: Cascade)
  
  addHint             String?
  priority            Int              @default(50)

  @@index([cardId, priority])
}

model ClinicalRevision {
  id           Int          @id @default(autoincrement())
  cardId       Int
  card         ClinicalCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  editorUserId String?
  editorEmail  String?
  editorName   String?
  action       String
  summary      String?
  payload      Json?

  @@index([cardId, createdAt])
}

model AdminPrompt {
  id        String   @id @default(cuid())
  label     String
  content   String   @db.Text
  createdAt DateTime @default(now())
}
