generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  password      String
  name          String?
  categories    Category[]
  templates     Template[]
  pcaDrugs PcaDrug[]
  createdAt     DateTime   @default(now())
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  userId    Int?       // Временно опционально для миграции
  user      User?      @relation(fields: [userId], references: [id])
  templates Template[]
}

model Template {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  author     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     Int?     // Временно опционально для миграции
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model PcaDrug {
  id        Int      @id @default(autoincrement())
  name      String
  strength  Float    // mg/ml
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

