generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ПОЛЬЗОВАТЕЛИ И АУТЕНТИФИКАЦИЯ
// ==========================================

model User {
  id             Int            @id @default(autoincrement())
  email          String         @unique
  password       String
  name           String?
  createdAt      DateTime       @default(now())

  // Обратные связи
  categories     Category[]
  templates      Template[]
  pcaDrugs       PcaDrug[]
  history        AIHistory[]
  aiTools        AiTool[]
  substanceNotes Substance[]    // Связь для Wiki-заметок
  
  // Новые связи для каталога ссылок
  linkCategories LinkCategory[]
  quickLinks     QuickLink[]
}

// ==========================================
// 2. ШАБЛОНЫ ТЕКСТОВ (MALLIT)
// ==========================================

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  userId    Int?       // null для общих категорий
  user      User?      @relation(fields: [userId], references: [id])
  templates Template[]
}

model Template {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  author     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

// ==========================================
// 3. КАЛЬКУЛЯТОРЫ И ИИ
// ==========================================

model PcaDrug {
  id        Int      @id @default(autoincrement())
  name      String
  strength  Float    // mg/ml
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

model AIHistory {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  mode         String   // fix, translate, summarize, malli
  originalText String   @db.Text
  resultText   String   @db.Text

  @@index([userId])
}

enum AiToolScope {
  SYSTEM
  USER
}

model AiTool {
  id          String      @id @default(cuid())
  key         String
  label       String
  description String?
  icon        String?
  prompt      String      @db.Text
  scope       AiToolScope
  userId      Int?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive    Boolean     @default(true)
  order       Int         @default(100)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([key])
  @@index([userId])
  @@index([scope, isActive, order])
}

// ==========================================
// 4. СПРАВОЧНИК ЛЕКАРСТВ (FIMEA + WIKI)
// ==========================================

model Substance {
  id              String     @id // Название вещества (напр. "takrolimuusi")
  communityNotes  String?    @db.Text
  lastUpdatedById Int?
  lastUpdatedBy   User?      @relation(fields: [lastUpdatedById], references: [id]) 
  
  laake75Class    String?    
  laake75Comment  String?    @db.Text
  gfrGuidelines   String?    @db.Text
  isBiological    Boolean    @default(false)
  medicines       Medicine[]
}

model Medicine {
  id               String     @id 
  name             String     
  atcCode          String?
  prescriptionTerm String?    @db.Text 
  isPediatric      Boolean    @default(false)
  isBiosimilar     Boolean    @default(false)
  status           String?    
  substance        Substance? @relation(fields: [substanceId], references: [id])
  substanceId      String?
  packages         Package[]

  @@index([name])
}

model Package {
  vnr         String   @id
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id])
  sizeText    String?
  strength    String?
  form        String?
  container   String?
  isAvailable Boolean  @default(true)
  dddValue    Float?
  dddUnit     String?
  updatedAt   DateTime @updatedAt

  @@index([medicineId])
}

// ==========================================
// 5. КЛИНИЧЕСКИЕ КАРТОЧКИ (PIKAOHJEET)
// ==========================================

model ClinicalCard {
  id              Int                @id @default(autoincrement())
  slug            String             @unique
  title           String
  subtitle        String?
  environment     String             @default("terveysasema")
  audience        String             @default("aikuinen")
  tags            String[]           @default([])
  isPublished     Boolean            @default(true)
  updatedAt       DateTime           @updatedAt
  createdAt       DateTime           @default(now())
  updatedByUserId String?
  updatedByEmail  String?
  updatedByName   String?

  sections        ClinicalSection[]
  fields          ClinicalField[]
  rules           ClinicalRule[]
  revisions       ClinicalRevision[]
}

model ClinicalSection {
  id               Int            @id @default(autoincrement())
  cardId           Int
  card             ClinicalCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  key              String
  title            String
  order            Int            @default(0)
  content          String         @db.Text
  highlightCallout String?
  
  rules            ClinicalRule[]

  @@unique([cardId, key])
  @@index([cardId, order])
}

model ClinicalField {
  id          Int            @id @default(autoincrement())
  cardId      Int
  card        ClinicalCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        String
  unit        String?
  placeholder String?
  options     String[]       @default([])
  order       Int            @default(0)
  isUniversal Boolean        @default(false)
  
  rules       ClinicalRule[]

  @@unique([cardId, key])
  @@index([cardId, order])
}

model ClinicalRule {
  id                  Int              @id @default(autoincrement())
  cardId              Int
  card                ClinicalCard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  groupId             String?
  fieldKey            String
  field               ClinicalField    @relation(fields: [cardId, fieldKey], references: [cardId, key], onDelete: Cascade)
  operator            String
  value               String
  highlightSectionKey String?
  section             ClinicalSection? @relation(fields: [cardId, highlightSectionKey], references: [cardId, key], onDelete: Cascade)
  addHint             String?
  priority            Int              @default(50)

  @@index([cardId, priority])
}

model ClinicalRevision {
  id           Int          @id @default(autoincrement())
  cardId       Int
  card         ClinicalCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  editorUserId String?
  editorEmail  String?
  editorName   String?
  action       String
  summary      String?
  payload      Json?

  @@index([cardId, createdAt])
}

// ==========================================
// 6. КАТАЛОГ ССЫЛОК (LINKIT JA OHJEET)
// ==========================================

model LinkCategory {
  id        Int         @id @default(autoincrement())
  name      String
  userId    Int?        // null = общая категория для всех
  user      User?       @relation(fields: [userId], references: [id])
  links     QuickLink[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model QuickLink {
  id          Int          @id @default(autoincrement())
  title       String       // Описание
  url         String       // Ссылка
  categoryId  Int
  category    LinkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId      Int?         // null = общая ссылка для всех
  user        User?        @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
  @@index([userId])
}

// ==========================================
// 7. СИСТЕМНОЕ
// ==========================================

model AdminPrompt {
  id        String   @id @default(cuid())
  label     String
  content   String   @db.Text
  createdAt DateTime @default(now())
}
